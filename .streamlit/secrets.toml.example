# Copy this file to  .streamlit/secrets.toml  (which is git-ignored) and fill in
# your keys. On Streamlit Community Cloud, paste the same contents into
# App → Settings → Secrets instead of using a file.
#
# Without any keys the app still runs and shows the bundled job snapshot.

# JSearch (RapidAPI) — aggregates LinkedIn, Indeed, Glassdoor, ZipRecruiter.
# Get a free key at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY = "your-rapidapi-key"

# Adzuna — broad job listings. Free keys at https://developer.adzuna.com/
ADZUNA_APP_ID = "your-adzuna-app-id"
ADZUNA_APP_KEY = "your-adzuna-app-key"
